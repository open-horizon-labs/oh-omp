{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/open-horizon-labs/successor-agent-kernel/schemas/authority-record.v0.json",
  "title": "Successor authority record v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority_state", "predecessor_commit", "source", "destination", "filter", "verification", "rollback", "excluded_local_state"],
  "properties": {
    "schema_version": { "const": "successor.authority.v0" },
    "authority_state": { "enum": ["source_authoritative_candidate_absent", "source_authoritative_candidate_read_only", "source_authoritative_candidate_published_read_only", "source_retired_destination_pending_activation", "destination_authoritative"] },
    "predecessor_commit": { "$ref": "#/$defs/gitCommit" },
    "source": { "$ref": "#/$defs/sourceState" },
    "destination": { "$ref": "#/$defs/destinationState" },
    "filter": { "$ref": "#/$defs/filterState" },
    "verification": { "type": "object", "additionalProperties": { "type": "string" } },
    "rollback": { "$ref": "#/$defs/rollbackState" },
    "excluded_local_state": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "authority_state": { "const": "source_authoritative_candidate_absent" } } },
      "then": {
        "properties": {
          "source": { "properties": { "remote_exists": { "const": true }, "writable": { "const": true }, "cut_commit": { "type": "null" }, "retirement_commit": { "type": "null" } } },
          "destination": { "properties": { "remote_exists": { "const": false }, "writable": { "const": false }, "candidate_commit": { "type": "null" }, "authority_commit": { "type": "null" } } },
          "filter": { "properties": { "observed_cli_version": { "type": "null" }, "argv": { "type": "null" }, "argv_sha256": { "type": "null" }, "commit_map_sha256": { "type": "null" } } },
          "verification": { "maxProperties": 0 }
        }
      }
    },
    {
      "if": { "properties": { "authority_state": { "const": "source_authoritative_candidate_read_only" } } },
      "then": {
        "properties": {
          "source": { "properties": { "remote_exists": { "const": true }, "writable": { "const": true }, "cut_commit": { "$ref": "#/$defs/gitCommit" }, "retirement_commit": { "type": "null" } } },
          "destination": { "properties": { "remote_exists": { "const": false }, "writable": { "const": false }, "candidate_commit": { "$ref": "#/$defs/gitCommit" }, "authority_commit": { "type": "null" } } },
          "filter": { "properties": { "observed_cli_version": { "type": "string", "minLength": 1 }, "argv": { "type": "array", "minItems": 1 }, "argv_sha256": { "$ref": "#/$defs/sha256" }, "commit_map_sha256": { "$ref": "#/$defs/sha256" } } },
          "verification": { "minProperties": 1 }
        }
      }
    },
    {
      "if": { "properties": { "authority_state": { "const": "source_authoritative_candidate_published_read_only" } } },
      "then": {
        "properties": {
          "source": { "properties": { "remote_exists": { "const": true }, "writable": { "const": true }, "cut_commit": { "$ref": "#/$defs/gitCommit" }, "retirement_commit": { "type": "null" } } },
          "destination": { "properties": { "remote_exists": { "const": true }, "writable": { "const": false }, "candidate_commit": { "$ref": "#/$defs/gitCommit" }, "authority_commit": { "type": "null" } } },
          "filter": { "properties": { "observed_cli_version": { "type": "string", "minLength": 1 }, "argv": { "type": "array", "minItems": 1 }, "argv_sha256": { "$ref": "#/$defs/sha256" }, "commit_map_sha256": { "$ref": "#/$defs/sha256" } } },
          "verification": { "minProperties": 1 }
        }
      }
    },
    {
      "if": { "properties": { "authority_state": { "const": "source_retired_destination_pending_activation" } } },
      "then": {
        "properties": {
          "source": { "properties": { "remote_exists": { "const": true }, "writable": { "const": false }, "cut_commit": { "$ref": "#/$defs/gitCommit" }, "retirement_commit": { "$ref": "#/$defs/gitCommit" } } },
          "destination": { "properties": { "remote_exists": { "const": true }, "writable": { "const": false }, "candidate_commit": { "$ref": "#/$defs/gitCommit" }, "authority_commit": { "type": "null" } } },
          "filter": { "properties": { "observed_cli_version": { "type": "string", "minLength": 1 }, "argv": { "type": "array", "minItems": 1 }, "argv_sha256": { "$ref": "#/$defs/sha256" }, "commit_map_sha256": { "$ref": "#/$defs/sha256" } } },
          "verification": { "minProperties": 1 }
        }
      }
    },
    {
      "if": { "properties": { "authority_state": { "const": "destination_authoritative" } } },
      "then": {
        "properties": {
          "source": { "properties": { "remote_exists": { "const": true }, "writable": { "const": false }, "cut_commit": { "$ref": "#/$defs/gitCommit" }, "retirement_commit": { "$ref": "#/$defs/gitCommit" } } },
          "destination": { "properties": { "remote_exists": { "const": true }, "writable": { "const": true }, "candidate_commit": { "$ref": "#/$defs/gitCommit" }, "authority_commit": { "$ref": "#/$defs/gitCommit" } } },
          "filter": { "properties": { "observed_cli_version": { "type": "string", "minLength": 1 }, "argv": { "type": "array", "minItems": 1 }, "argv_sha256": { "$ref": "#/$defs/sha256" }, "commit_map_sha256": { "$ref": "#/$defs/sha256" } } },
          "verification": { "minProperties": 1 }
        }
      }
    }
  ],
  "$defs": {
    "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "nullableGitCommit": { "anyOf": [{ "$ref": "#/$defs/gitCommit" }, { "type": "null" }] },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullableSha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "sourceState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "default_branch", "remote_exists", "writable", "cut_commit", "retirement_commit"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "default_branch": { "type": "string", "minLength": 1 },
        "remote_exists": { "type": "boolean" },
        "writable": { "type": "boolean", "description": "Whether successor mutations are authorized in this repository by the authority protocol; not a statement about provider ACL or administrator capability." },
        "cut_commit": { "$ref": "#/$defs/nullableGitCommit" },
        "retirement_commit": { "$ref": "#/$defs/nullableGitCommit" }
      }
    },
    "destinationState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "default_branch", "remote_exists", "writable", "candidate_commit", "authority_commit"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "default_branch": { "type": "string", "minLength": 1 },
        "remote_exists": { "type": "boolean" },
        "writable": { "type": "boolean", "description": "Whether successor mutations are authorized in this repository by the authority protocol; not a statement about provider ACL or administrator capability." },
        "candidate_commit": { "$ref": "#/$defs/nullableGitCommit" },
        "authority_commit": { "$ref": "#/$defs/nullableGitCommit" }
      }
    },
    "filterState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "package_version", "observed_cli_version", "argv", "argv_sha256", "commit_map_sha256"],
      "properties": {
        "tool": { "const": "git-filter-repo" },
        "package_version": { "const": "2.47.0" },
        "observed_cli_version": { "type": ["string", "null"] },
        "argv": { "type": ["array", "null"], "items": { "type": "string" } },
        "argv_sha256": { "$ref": "#/$defs/nullableSha256" },
        "commit_map_sha256": { "$ref": "#/$defs/nullableSha256" }
      }
    },
    "rollbackState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reason"],
      "properties": {
        "decision": { "enum": ["not_required", "candidate_discarded", "source_retained", "destination_decommissioned"] },
        "reason": { "type": ["string", "null"] }
      }
    }
  }
}
